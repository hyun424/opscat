!infra/gcp/p176-cost-cutoff/terraform.tfvars.template
infra/gcp/p176-cost-cutoff/*.tfplan
infra/gcp/p176-cost-cutoff/*.tfplan.json
infra/gcp/p176-cost-cutoff/*.tfplan.sha256
infra/gcp/p176-cost-cutoff/*.tfplan.digest
infra/gcp/p176-cost-cutoff/*.stdout
infra/gcp/p176-cost-cutoff/*.stderr
infra/gcp/p176-cost-cutoff/*.stdout.*
infra/gcp/p176-cost-cutoff/*.stderr.*
infra/gcp/p176-cost-cutoff/crash.log
infra/gcp/p176-cost-cutoff/crash.*.log
infra/gcp/p176-cost-cutoff/*.log
lab/p176/live/.env
lab/p176/live/runtime/
evals/p176/live/

# P176 G001 public evidence may contain only redacted review JSON. Keep raw
# plans, plan JSON, logs, tfvars, and digest sidecars in local Terraform
# custody instead.
evals/p176/g001-no-apply/**/*.tfplan
evals/p176/g001-no-apply/**/*.tfplan.*
evals/p176/g001-no-apply/**/*plan*.json
evals/p176/g001-no-apply/**/*.tfvars
evals/p176/g001-no-apply/**/*tfvars*
evals/p176/g001-no-apply/**/*.log
evals/p176/g001-no-apply/**/*.log.*
evals/p176/g001-no-apply/**/*.stdout
evals/p176/g001-no-apply/**/*.stderr
evals/p176/g001-no-apply/**/*.stdout.*
evals/p176/g001-no-apply/**/*.stderr.*
evals/p176/g001-no-apply/**/*.txt
evals/p176/**/*.tfplan
evals/p176/**/*.tfplan.*
evals/p176/**/*plan*.json
evals/p176/**/*.tfvars
evals/p176/**/*tfvars*
evals/p176/**/*.log
evals/p176/**/*.log.*
evals/p176/**/*.stdout
evals/p176/**/*.stderr
evals/p176/**/*.stdout.*
evals/p176/**/*.stderr.*
!evals/p176/g001-no-apply/**/*.redacted.json
