      "declared_scopes": ["metrics:read", "query:read"],
      "expected_fields": ["status", "data", "result"],
      "observed_fields": ["status", "data", "result"],
      "mock_transport": {"status": "healthy", "latency_ms": 120, "timeout_ms": 1000, "rate_limited": false, "retry_after_ms": 0}
    },
    {
      "id": "p33-datadog-readonly",
