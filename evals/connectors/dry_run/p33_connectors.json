      "expected_fields": ["series", "events"],
      "observed_fields": ["series", "events"],
      "mock_transport": {"status": "healthy", "latency_ms": 180, "timeout_ms": 1500, "rate_limited": false, "retry_after_ms": 0}
    },
    {
      "id": "p33-sentry-schema-drift",
      "provider": "sentry",
      "endpoint_ref": "env:SENTRY_API_URL",
      "credential_ref": "env:SENTRY_READ_TOKEN",
      "declared_scopes": ["event:read", "project:read"],
      "expected_fields": ["issues", "events", "lastSeen"],
      "observed_fields": ["issues", "last_seen", "events"],
      "mock_transport": {"status": "healthy", "latency_ms": 220, "timeout_ms": 1500, "rate_limited": false, "retry_after_ms": 0}
    },
    {
      "id": "p33-unsafe-admin-token",
