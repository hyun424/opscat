[Unit]
Description=OpsCat credential-free local triage supervisor
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
User=opscat
Group=opscat
ExecStart=/usr/local/bin/opscat-triage-service run --bundle /etc/opscat/p139-service-bundle.json --base /var/lib/opscat
ExecStartPre=/usr/local/bin/opscat-triage-service validate --bundle /etc/opscat/p139-service-bundle.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateNetwork=true
ReadOnlyPaths=/etc/opscat
ReadWritePaths=/var/lib/opscat
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
