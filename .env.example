# OpsCat local/mock development defaults.
# Copy to .env only if you want to override shell environment values.
# Do not use production credentials or customer data in local OSS demos.

OPSCAT_MODE=local-mock
DATABASE_URL=sqlite:///./opscat.db
REPORT_DIR=data/mock_reports

# Demo identity is header/local only. No auth setup is required for P5 quickstart.
OPSCAT_DEMO_TENANT=demo
OPSCAT_DEMO_WORKSPACE=demo
OPSCAT_DEMO_ACTOR=demo-user@opscat.local
OPSCAT_DEMO_ROLE=admin

# Real provider credentials are intentionally omitted.
# Keep Sentry/GitHub/Slack tokens unset unless a future explicit connector task says otherwise.
