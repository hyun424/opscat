!infra/gcp/p176-live/terraform.tfvars.template
infra/gcp/p176-live/*.tfplan
infra/gcp/p176-live/*.tfplan.json
infra/gcp/p176-live/*.tfplan.sha256
infra/gcp/p176-live/*.tfplan.digest
infra/gcp/p176-live/*.stdout
infra/gcp/p176-live/*.stderr
infra/gcp/p176-live/*.stdout.*
infra/gcp/p176-live/*.stderr.*
infra/gcp/p176-live/crash.log
infra/gcp/p176-live/crash.*.log
infra/gcp/p176-live/*.log
infra/gcp/p176-cost-cutoff/.terraform/
infra/gcp/p176-cost-cutoff/.terraform/**
infra/gcp/p176-cost-cutoff/.terraform.d/
infra/gcp/p176-cost-cutoff/*.tfstate
infra/gcp/p176-cost-cutoff/*.tfstate.*
infra/gcp/p176-cost-cutoff/terraform.tfvars
infra/gcp/p176-cost-cutoff/*.tfvars
infra/gcp/p176-cost-cutoff/*.tfvars.*
