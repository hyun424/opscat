[Unit]
Description=OpsCat local notification-only authority simulator
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=simple
User=opscat
Group=opscat
ExecStartPre=/usr/local/bin/opscat-notification-authority validate --config /etc/opscat/p141-notification.json
ExecStart=/usr/local/bin/opscat-notification-authority run --config /etc/opscat/p141-notification.json --forever
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateNetwork=true
ReadOnlyPaths=/etc/opscat
ReadOnlyPaths=/var/lib/opscat/p133
ReadWritePaths=/var/lib/opscat/p133/.cursor.json.lock
ReadWritePaths=/var/lib/opscat/p141
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
