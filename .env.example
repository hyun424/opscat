# OpsCat local/mock development defaults.
# Copy to .env only if you want to override shell environment values.
# Do not use production credentials or customer data in local OSS demos.

OPSCAT_MODE=local-mock
DATABASE_URL=sqlite:///./opscat.db
REPORT_DIR=data/mock_reports

# Demo identity is header/local only. No auth setup is required for P5 quickstart.
OPSCAT_DEMO_TENANT=demo
OPSCAT_DEMO_WORKSPACE=demo
OPSCAT_DEMO_ACTOR=demo-user@opscat.local
OPSCAT_DEMO_ROLE=admin

# Real provider credentials are intentionally omitted.
# Keep Sentry/GitHub/Slack tokens unset unless a future explicit connector task says otherwise.

# Optional P96 Prometheus shadow connector. Fixture mode is always the default.
# Real mode must be selected explicitly by the probe and the hostname must appear
# in this allowlist. Plain HTTP is accepted only for loopback development.
OPSCAT_PROMETHEUS_BASE_URL=
OPSCAT_PROMETHEUS_ALLOWED_HOSTS=localhost,127.0.0.1,::1
OPSCAT_PROMETHEUS_TIMEOUT_SECONDS=5

# P131 standalone local JSONL monitor status surfaces. The monitor process
# itself is configured by config/p131-monitor.example.json and uses no secrets.
OPSCAT_MONITOR_STATE_PATH=data/p131/runtime-state.json
OPSCAT_MONITOR_HEARTBEAT_TIMEOUT_SECONDS=180
OPSCAT_MONITOR_DATA_STALE_AFTER_SECONDS=300
