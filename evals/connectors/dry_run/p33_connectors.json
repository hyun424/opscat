      "expected_fields": ["series"],
      "observed_fields": ["series"],
      "mock_transport": {"status": "healthy", "latency_ms": 90, "timeout_ms": 1000, "rate_limited": false, "retry_after_ms": 0},
      "unsafe_example_secret": "actual-secret-value"
    }
  ]
