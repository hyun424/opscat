.ruff_cache/
opscat.db
.env
data/mock_reports/*.md
data/p131/
*$py.class
*.egg-info/
build/
dist/

# The uv lockfile is tracked for reproducible open-source builds.

# Downloaded public benchmark archives/expanded telemetry are reproducible but
# too large to version. Keep only manifests and evaluation reports.
evals/real_datasets/external/p110/raw/
evals/real_datasets/external/p110/results/batch-*/
evals/real_datasets/external/p110/results/candidate-*.json
evals/real_datasets/external/p110/results/candidate-packets.json
evals/real_datasets/external/p110/results/evaluation-*.json
evals/real_datasets/external/p110/results/release-*.json
evals/real_datasets/external/p110/results/summary-*.md

# P111 provider batch/development artifacts are reproducible local working
# data. Preserve only the frozen blind merged evidence used by release replay.
evals/real_datasets/external/p111/results/development/
evals/real_datasets/external/p111/results/validation/
evals/real_datasets/external/p111/results/smoke/
evals/real_datasets/external/p111/results/blind/baseline/batch-*/
evals/real_datasets/external/p111/results/blind/candidate-run1/batch-*/
evals/real_datasets/external/p111/results/blind/candidate-run2/batch-*/

# P112 official archives and live provider working outputs are reproducible and
# intentionally kept out of source control. Preserve manifests and merged
# release evidence only.
evals/real_datasets/external/p112/raw/
evals/real_datasets/external/p112/results/development/
evals/real_datasets/external/p112/results/validation/
evals/real_datasets/external/p112/results/confirmation/batch-*/
evals/real_datasets/external/p112/results/blind/baseline/batch-*/
evals/real_datasets/external/p112/results/blind/candidate-run1/batch-*/
evals/real_datasets/external/p112/results/blind/candidate-run2/batch-*/

# P113 Train Ticket archive and provider batch outputs are reproducible local
# artifacts. Track only the pinned source manifest and merged release evidence.
evals/real_datasets/external/p113/raw/
evals/real_datasets/external/p113/results/development/
evals/real_datasets/external/p113/results/validation/
evals/real_datasets/external/p113/results/blind/diagnosis/batch-*/
evals/real_datasets/external/p113/results/blind/narrative-run1/batch-*/
evals/real_datasets/external/p113/results/blind/narrative-run2/batch-*/

# P114 RE2 source archives and provider working outputs are reproducible local
# artifacts. Track only pinned source manifests and merged release evidence.
evals/real_datasets/external/p114/raw/
evals/real_datasets/external/p114/results/development/
evals/real_datasets/external/p114/results/validation/
evals/real_datasets/external/p114/results/blind/batch-*/
.coverage
htmlcov/

# P174 GCP lab state and runtime credentials are local-only. The checked-in
# examples contain no credentials and live evidence is exported separately.
infra/gcp/p174/.terraform/
infra/gcp/p174/.terraform.d/
infra/gcp/p174/.terraform.lock.hcl.tmp
infra/gcp/p174/*.tfstate
infra/gcp/p174/*.tfstate.*
infra/gcp/p174/terraform.tfvars
infra/gcp/p174/*.tfplan
infra/gcp/p174/*.tfplan.json
infra/gcp/p174/*.tfplan.sha256
infra/gcp/p174/*.tfplan.txt
infra/gcp/p174/crash.log
infra/gcp/p174/crash.*.log
lab/p174/.env
lab/p174/runtime/*.env
lab/p174/runtime/*-manifest.json
lab/p174/runtime/*capability*
lab/p174/runtime/*provider-payload*
lab/p174/runtime/*raw-payload*
evals/p174/live/

# P176 disposable live-lab state, reviewed plans, and runtime outputs are local.
infra/gcp/p176-live/.terraform/
infra/gcp/p176-live/.terraform/**
infra/gcp/p176-live/.terraform.d/
infra/gcp/p176-live/*.tfstate
infra/gcp/p176-live/*.tfstate.*
infra/gcp/p176-live/terraform.tfvars
infra/gcp/p176-live/*.tfvars
infra/gcp/p176-live/*.tfvars.*
